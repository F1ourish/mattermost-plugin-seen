    "esbuild": "0.25.12",
    "eslint": "10.11.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "playwright": "1.62.1",
    "prettier": "3.6.2",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "typescript": "5.9.3",
